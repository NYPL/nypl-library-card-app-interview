# Local development configuration.
#
# The three API URLs below point at the in-repo mock endpoints under
# pages/api/__mock__, so the signup flow runs end to end without NYPL
# credentials. See "Running locally with mock APIs" in the README.
#
# These use `next dev`'s default port, since the server calls them over loopback.
OAUTH_PROVIDER_URL=http://localhost:3000/library-card/api/__mock__/token
PATRON_CREATION_URL=http://localhost:3000/library-card/api/__mock__/patrons
PATRON_VALIDATION_URL=http://localhost:3000/library-card/api/__mock__/validations

# NODE_ENV is set by the npm script (`next dev` / `next build`), so it is
# deliberately not set here: a committed value would follow a production
# build and turn off secure cookies.
LOG_LEVEL=debug
# Must be a domain the browser will accept for localhost, or the
# `nyplUserRegistered` cookie is silently dropped.
COOKIE_DOMAIN=localhost

NEXT_PUBLIC_APP_URL=https://www.nypl.org
NEXT_PUBLIC_DS_GLOBAL_HEADER=https://ds-header.nypl.org/header.min.js?containerId=nypl-header
NEXT_PUBLIC_DS_GLOBAL_FOOTER=https://ds-header.nypl.org/footer.min.js?containerId=nypl-footer
